# Copie para .env e preencha. O .env fica fora do Git.

# Token que a extensão do Brave usa para falar com o backend.
# Gere com: python -m ofertinhas new-token
EXTENSION_TOKEN=
# Opcional: chrome-extension://<id da extensão> (aparece em brave://extensions)
EXTENSION_ORIGIN=
API_PORT=8765

# Bot do Telegram (crie no @BotFather). ADMIN_CHAT_ID é o seu chat privado com o bot:
# mande /chatid para o bot depois que ele estiver rodando.
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=

# Sua etiqueta de afiliado do Mercado Livre (aparece no Gerador de link e nos links /social/<tag>).
ML_AFFILIATE_TAG=

# API da WhatsMiau.dev: chave do painel e nome da instância já conectada.
WHATSMIAU_API_KEY=
WHATSMIAU_INSTANCE=

# Opcionais
# OFERTINHAS_DATA_DIR=data
# OFERTINHAS_CONFIG=config.yaml
