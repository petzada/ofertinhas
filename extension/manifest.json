{
  "manifest_version": 3,
  "name": "Ofertinhas",
  "version": "0.3.0",
  "description": "Coleta ofertas do portal de afiliados do Mercado Livre e das Ofertas do Dia da Amazon, e gera links para o backend do Ofertinhas.",
  "minimum_chrome_version": "111",
  "permissions": ["alarms", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://www.mercadolivre.com.br/*",
    "https://www.amazon.com.br/*",
    "http://127.0.0.1/*",
    "https://ofertinhas.marciopetigrosso.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.mercadolivre.com.br/*"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Ofertinhas",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
